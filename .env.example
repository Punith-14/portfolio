# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------- GitHub
# Optional, but strongly recommended. Without it you get 60 API requests per
# hour shared across your whole IP; with it, 5,000.
# Create at https://github.com/settings/tokens — a classic token with NO scopes
# is enough, since it only reads public repos.
GITHUB_TOKEN=

# ---------------------------------------------------------------- Gemini
# Optional. Only used to condense a long README into two sentences. Without it
# the site falls back to your GitHub repo descriptions, which is fine.
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ----------------------------------------------------------------- Email
# Required for the contact form to actually send mail. Without it, messages are
# logged to the server console instead.
# Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender, which works with no domain
# setup. Once you verify your own domain, change this to something like
# "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Optional. Defaults to the email in lib/site-config.ts.
CONTACT_TO_EMAIL=
